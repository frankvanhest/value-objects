{
    "name": "frankvanhest/value-objects",
    "description": "Value Objects interfaces and abstracts to create value objects",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Frank van Hest",
            "email": "frank@frankvanhest.nl"
        }
    ],
    "require": {
        "php": "~8.4.0 || ~8.5.0"
    },
    "require-dev": {
        "beberlei/assert": "~v3.3",
        "infection/infection": "^0.32",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "FrankVanHest\\ValueObjects\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FrankVanHest\\ValueObjects\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
